{
  "name": "@devlander-software/issue-labler",
  "version": "1.2.2",
  "description": "TypeScript definitions for GitHub Auto-Label Issues & Templates Action",
  "main": "types/index.d.ts",
  "types": "types/index.d.ts",
  "files": [
    "types/**/*.d.ts",
    "README.md"
  ],
  "keywords": [
    "github",
    "action",
    "typescript",
    "types",
    "definitions",
    "issue",
    "label",
    "template",
    "automation",
    "workflow"
  ],
  "author": "Devlander-Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devlander-Software/issue-labler.git"
  },
  "bugs": {
    "url": "https://github.com/Devlander-Software/issue-labler/issues"
  },
  "homepage": "https://github.com/Devlander-Software/issue-labler#readme",
  "devDependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "conventional-changelog-cli": "^4.1.0",
    "jest": "^29.0.0",
    "js-yaml": "^4.1.0",
    "nock": "^13.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "changelog:first": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 --first-release",
    "version": "npm run changelog && git add CHANGELOG.md",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:bash": "npm run install-bats && ./node_modules/.bats/bats-core/bin/bats tests/bash/",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:bash",
    "install-bats": "./scripts/install-bats.sh",
    "generate:templates": "node scripts/generate-templates.js",
    "generate:analysis": "node scripts/generate-templates.js --analysis",
    "generate:all": "npm run generate:templates && npm run generate:analysis",
    "analyze": "node scripts/analyze-issues.js",
    "analyze:full": "npm run generate:analysis && npm run analyze",
    "create:labels": "npm run build && node scripts/create-labels.js",
    "auto:label": "npm run build && node scripts/auto-label.js"
  },
  "conventionalChangelog": {
    "preset": "angular",
    "releaseCount": 0,
    "outputUnreleased": true
  }
}
